<!-- Local rules for the custom-misp integration. Place in /var/ossec/etc/rules/ -->
<group name="misp,">
  <!-- every event the integration writes back -->
  <rule id="100620" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">^misp$</field>
    <description>MISP integration event</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100621" level="5">
    <if_sid>100620</if_sid>
    <field name="misp.error">\.+</field>
    <description>MISP - error querying the API: $(misp.error)</description>
    <options>no_full_log</options>
    <group>misp_error,</group>
  </rule>

  <rule id="100622" level="12">
    <if_sid>100620</if_sid>
    <field name="misp.category">\.+</field>
    <description>MISP - IoC found in threat intel. Category: $(misp.category), $(misp.type): $(misp.value)</description>
    <options>no_full_log</options>
    <group>misp_alert,</group>
  </rule>
</group>
